# Radiology Copilot — environment configuration
#
# Copy to `.env` and fill in.  `.env` is git-ignored; never commit real keys.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Language model (optional)
# ---------------------------------------------------------------------------
# The application runs fully without these: the agent falls back to a
# deterministic Python workflow and the UI says so explicitly.  Configure them
# to enable real LLM function calling and LLM-written report narrative.
#
# Any OpenAI-compatible endpoint works.  Examples:
#
#   DeepSeek   LLM_BASE_URL=https://api.deepseek.com
#              LLM_MODEL=deepseek-chat
#
#   OpenAI     LLM_BASE_URL=https://api.openai.com/v1
#              LLM_MODEL=gpt-4o-mini
#
#   Local vLLM LLM_BASE_URL=http://127.0.0.1:8000/v1
#              LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---------------------------------------------------------------------------
# Model / data mirrors
# ---------------------------------------------------------------------------
# HuggingFace is not reachable from every network.  Point this at a mirror when
# the default endpoint is blocked; the project also has a built-in fallback.
# HF_ENDPOINT=https://hf-mirror.com

# ---------------------------------------------------------------------------
# Inference device
# ---------------------------------------------------------------------------
# Leave unset to let the app choose the GPU with the most free memory and the
# lowest utilisation, falling back to CPU when nothing suitable is available.
# RADIOLOGY_DEVICE=cuda:0
# RADIOLOGY_DEVICE=cpu

# ---------------------------------------------------------------------------
# Gradio server
# ---------------------------------------------------------------------------
# GRADIO_SERVER_PORT=7860
# GRADIO_ANALYTICS_ENABLED=False
